{
  "name": "brislane-lending-platform",
  "version": "0.2.0",
  "private": true,
  "description": "Brislane Lend quality and Playwright automation framework",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:api": "playwright test tests/api",
    "test:smoke": "playwright test tests/loan/start.spec.ts",
    "test:headed": "playwright test --headed",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@axe-core/playwright": "^4.9.0",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  }
}
